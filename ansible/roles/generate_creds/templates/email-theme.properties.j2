parent=base

# Generated by the generate_creds role - `mise run start` overwrites this file. Do not edit by hand.
#
# parent=base is load-bearing: password-reset.ftl and privacyidea-otp.ftl both wrap their body in
# <@layout.emailLayout> from the base email theme's template.ftl, so deleting this file breaks every
# email, not just branding.
#
# emailBaseUrl is the public origin Keycloak-generated mail uses for theme assets. It cannot come
# from an authenticator config field: FreeMarkerEmailTemplateProvider binds a fixed model with no
# realm bean and no admin config, and a template cannot read environment variables, so a theme
# property is the only per-environment value such a template can reach. It is rendered here from
# keycloak_public_base_url, which derives from keycloak_host - the same variable .env takes
# KEYCLOAK_HOST from, so the two cannot disagree for a given host.
#
# Mail our own provider sends (the OTP mail) does not use this. It gets the value injected as
# otpEmailBaseUrl from the publicBaseUrl field on the EDC MFA Channels execution.
emailBaseUrl={{ keycloak_public_base_url }}