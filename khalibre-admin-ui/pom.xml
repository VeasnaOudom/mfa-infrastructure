<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.khalibre</groupId>
    <version>26.1.3</version>
    <artifactId>khalibre-admin-ui</artifactId>
    <name>Khalibre Admin UI</name>
    <description>The EDC MFA channels page, added to the Keycloak administration console.</description>

    <!--
      This module only packages. The console itself is built by Vite inside a pinned checkout of the
      Keycloak JS sources - see scripts/patch-admin-ui.mjs and the build:khalibre-admin-ui task - and
      leaves its output in target/console, which is then copied into the theme jar below.

      So the order matters: build the console first, then `mvn package`. Running `mvn clean package` on
      its own deletes target/console and still produces a jar, and that jar is a theme with no
      console in it. Nothing else in the repository depends on this module, so use the mise task.

      Deliberately no frontend-maven-plugin: the npm build here would install this directory's own
      dependencies, and the console is not built from this directory. package.json records the
      versions the page imports so an editor can resolve them; it is not an install manifest.
    -->
    <build>
        <resources>
            <resource>
                <directory>maven-resources</directory>
            </resource>
            <resource>
                <directory>target/console</directory>
                <targetPath>theme/khalibre-admin/admin/resources</targetPath>
            </resource>
        </resources>
    </build>
</project>